{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/es/", "destination": "/es/index.html" },
    { "source": "/es/privacidad", "destination": "/es/privacidad.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
